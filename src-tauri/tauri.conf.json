{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sonara Stream",
  "version": "0.3.1",
  "identifier": "com.sonara.stream",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sonara Stream",
        "width": 1200,
        "height": 740,
        "minWidth": 950,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "center": true,
        "transparent": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; media-src 'self' https://*.googlevideo.com blob:; img-src 'self' https://*.ytimg.com https://*.mzstatic.com https://*.scdn.co https://*.spotifycdn.com data: blob:; connect-src 'self' ipc: http://ipc.localhost https://suggestqueries.google.com https://itunes.apple.com https://open.spotify.com;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/yt-dlp"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdGREIyODIwRDZDQUY4OTUKUldTVitNcldJQ2piZi9DSjd0L3hUZHRETjUxNDdaS1FraUhaMFpldVVkSVM5U0JKSG0rYllXcWIK",
      "endpoints": [
        "https://github.com/rayyanbobs-art/sonara-stream/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
