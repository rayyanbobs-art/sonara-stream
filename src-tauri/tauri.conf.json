{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sonara Stream",
  "version": "0.1.0",
  "identifier": "com.sonara.stream",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sonara Stream",
        "width": 1200,
        "height": 740,
        "minWidth": 950,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "center": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'; media-src 'self' https: http: blob:; img-src 'self' https: http: data: blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/yt-dlp"]
  }
}
